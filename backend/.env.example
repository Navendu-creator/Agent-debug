# Nagent settings. Copy to backend/.env and fill in at least one repository (token + owner + repo).
# Everything else is optional. With Docker: `docker compose up -d --build`, and after any change
# to this file `docker compose up -d` again.

# ---------- GitHub repository ----------
# Fine-grained token for that repository with "Contents: Read and write" + "Pull requests: Read and write".
GITHUB_TOKEN=
# Either owner + repo, or paste the repository URL into GITHUB_REPO (https://github.com/owner/repo).
GITHUB_OWNER=
GITHUB_REPO=
# Branch the PR targets (default main).
GITHUB_BASE_BRANCH=
# Folders the AI may read and change, comma-separated (e.g. terraform/,k8s/). Empty = whole repository.
# .github/, .env files, keys, *.tfstate and lock files are always off-limits.
GITHUB_ALLOWED_PATHS=

# ---------- GitLab repository (optional, can be used alongside GitHub) ----------
# Project/personal access token with the "api" scope (Developer role).
GITLAB_TOKEN=
# Group (nested: group/subgroup) + project, or the project URL in GITLAB_REPO.
GITLAB_OWNER=
GITLAB_REPO=
GITLAB_BASE_BRANCH=
GITLAB_ALLOWED_PATHS=
# Only for self-managed GitLab (default https://gitlab.com).
GITLAB_URL=

# ---------- More repositories (optional) ----------
# Repeat a block with a numeric suffix; each gets an entry in the report form's Repository picker.
# GITHUB_TOKEN_2=
# GITHUB_OWNER_2=
# GITHUB_REPO_2=
# GITHUB_BASE_BRANCH_2=
# GITHUB_ALLOWED_PATHS_2=

# ---------- AI (Ollama) ----------
# Docker runs Ollama for you; without Docker start it with `ollama serve`.
# qwen3:8b needs ~6-8 GB free RAM; qwen3:4b is faster on small machines. Downloaded automatically.
OLLAMA_MODEL=qwen3:8b
# Only used without Docker (Docker always uses its own Ollama container).
OLLAMA_BASE_URL=http://127.0.0.1:11434
# CPU threads for the model (unset = all physical CPU cores; shown in the UI header's health status).
# OLLAMA_NUM_THREAD=8
# Context window; more = more RAM.
# OLLAMA_NUM_CTX=8192
# Max time per model call in ms (default 30 min; slow CPUs / Docker Desktop may need more).
# AI_TIMEOUT_MS=1800000

# ---------- Notifications and alert intake (optional) ----------
# Teams / Power Automate HTTP trigger URL.
TEAMS_WEBHOOK_URL=
# Required for POST /api/webhooks/* — generate with: openssl rand -hex 32
WEBHOOK_SIGNING_SECRET=

# Docker host port / bind address (WEB_PORT, WEB_BIND) go in a .env next to docker-compose.yml.
