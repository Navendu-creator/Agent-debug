# GITHUB_OWNER=
# GITHUB_REPO=
# GITHUB_BASE_BRANCH=
# GITHUB_ALLOWED_PATHS=

# # GitLab (optional, can be used alongside GitHub — pick per incident in the UI)
# GITLAB_TOKEN=
# GITLAB_OWNER=
# GITLAB_REPO=
# GITLAB_BASE_BRANCH=main
# GITLAB_ALLOWED_PATHS=
# GITLAB_URL=https://gitlab.com

# # More repositories: same settings with a numeric suffix (_2, _3, …), e.g.
# GITHUB_TOKEN_2=
# GITHUB_OWNER_2=
# GITHUB_REPO_2=
# GITHUB_BASE_BRANCH_2=main
# GITHUB_ALLOWED_PATHS_2=
 
# # Ollama
# OLLAMA_BASE_URL=
# OLLAMA_MODEL=
# OLLAMA_NUM_THREAD=          # CPU threads; unset = Ollama default (P-cores only on hybrid Intel CPUs)
 
# # Webhook secret: generate one with  openssl rand -hex 32
# WEBHOOK_SIGNING_SECRET=
# GITHUB_TOKEN=
 
# TEAMS_WEBHOOK_URL=
 